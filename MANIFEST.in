# ExifTool (git submodule), without its docs, tests and build files
graft sortphotos/exiftool
prune sortphotos/exiftool/html
prune sortphotos/exiftool/t
prune sortphotos/exiftool/fmt_files
prune sortphotos/exiftool/config_files
prune sortphotos/exiftool/arg_files
exclude sortphotos/exiftool/Makefile.PL sortphotos/exiftool/META.* sortphotos/exiftool/validate
exclude sortphotos/exiftool/windows_exiftool sortphotos/exiftool/pp_build_exe.args
exclude sortphotos/exiftool/perl-Image-ExifTool.spec sortphotos/exiftool/Changes
exclude sortphotos/exiftool/build_tag_lookup
global-exclude .git
